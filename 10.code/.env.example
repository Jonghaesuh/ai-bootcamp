# ===== LLM 제공자 =====
# azure(기본) | ollama | openai | gemini   (azure 외는 `uv sync --extra local` 필요)
LLM_PROVIDER=azure
LLM_TEMPERATURE=0
# 응답 토큰 상한 (반복 생성으로 멈추지 않도록)
LLM_NUM_PREDICT=2048
# LLM 요청 하나의 최대 대기 시간(초)
LLM_TIMEOUT_SECONDS=600

# Azure OpenAI. 과제 실행 환경의 AOAI_* 변수를 그대로 읽는다 (AZURE_OPENAI_* 이름도 가능)
AOAI_ENDPOINT=
AOAI_API_KEY=
AOAI_API_VERSION=2024-10-21
# 채팅 배포 (기본 AOAI_DEPLOY_GPT41_MINI). 다른 배포는 AZURE_CHAT_DEPLOYMENT로 지정
AOAI_DEPLOY_GPT41_MINI=gpt-4.1-mini
# AZURE_CHAT_DEPLOYMENT=
# 임베딩 배포 (기본 AOAI_DEPLOY_EMBED_3_SMALL). 다른 배포는 AZURE_EMBEDDING_DEPLOYMENT로 지정
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
# AZURE_EMBEDDING_DEPLOYMENT=

# Ollama (LLM_PROVIDER=ollama)
LLM_MODEL=qwen2.5:14b-instruct
# Ollama 컨텍스트 길이 (기본 4096이면 긴 프롬프트가 앞부분부터 잘림)
LLM_NUM_CTX=16384
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI 호환 엔드포인트 (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Google Gemini (LLM_PROVIDER=gemini). https://aistudio.google.com 에서 발급
GOOGLE_API_KEY=

# ===== 임베딩 =====
# azure(기본) | ollama(EMBEDDING_MODEL=bge-m3) | openai. 바꾸면 `make index`로 인덱스를 다시 만든다
EMBEDDING_PROVIDER=azure
EMBEDDING_MODEL=bge-m3

# ===== 경로 =====
DATA_DIR=./data
RAW_DATA_DIR=./data/raw/olist
DB_PATH=./data/db/olist.duckdb
CHROMA_DIR=./storage/chroma
CHECKPOINT_DB=./storage/checkpoints/checkpoints.sqlite
STORE_DB=./storage/store/store.sqlite
PROJECT_DB=./storage/store/projects.sqlite
ARTIFACT_DIR=./storage/artifacts
PROMPT_DIR=./prompts
CONFIG_PATH=./config.yaml

# ===== MCP 카탈로그 서버 =====
# stdio | streamable-http
MCP_TRANSPORT=streamable-http
MCP_CATALOG_URL=http://localhost:8765/mcp

# ===== 서비스 =====
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
UI_PORT=8501

# ===== 데모 모드 (LLM 없이 기록된 응답으로 재현) =====
DEMO_MODE=false
# 실제 LLM 응답을 DEMO_RECORDINGS_DIR에 기록 (데모용 녹화)
LLM_RECORD=false
DEMO_RECORDINGS_DIR=./demo/recordings

# ===== A2A (2단계) =====
A2A_MODELING_AGENT_URL=http://localhost:9999

LOG_LEVEL=INFO
