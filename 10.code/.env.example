# ===== LLM 제공자 =====
# ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI 호환 엔드포인트 (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (LLM_PROVIDER=anthropic, 예: LLM_MODEL=claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# ===== 임베딩 =====
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3

# ===== 경로 =====
DATA_DIR=./data
RAW_DATA_DIR=./data/raw/olist
DB_PATH=./data/db/olist.duckdb
CHROMA_DIR=./storage/chroma
CHECKPOINT_DB=./storage/checkpoints/checkpoints.sqlite
STORE_DB=./storage/store/store.sqlite
ARTIFACT_DIR=./storage/artifacts
PROMPT_DIR=./prompts
CONFIG_PATH=./config.yaml

# ===== MCP 카탈로그 서버 =====
# stdio | streamable-http
MCP_TRANSPORT=streamable-http
MCP_CATALOG_URL=http://localhost:8765/mcp

# ===== 서비스 =====
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
UI_PORT=8501

# ===== 데모 모드 (LLM 없이 기록된 응답으로 재현) =====
DEMO_MODE=false
DEMO_RECORDINGS_DIR=./demo/recordings

# ===== A2A (2단계) =====
A2A_MODELING_AGENT_URL=http://localhost:9999

LOG_LEVEL=INFO
